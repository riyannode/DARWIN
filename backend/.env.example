# PostgreSQL connection used by deployed API and worker.
DATABASE_URL=
# OpenAI key used only by backend agent runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Official Binance Agent OS MCP endpoint.
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
# Fernet key generated outside the repository.
TOKEN_ENCRYPTION_KEY=
# Argon2id hash generated locally without storing the plaintext here.
OWNER_PASSWORD_HASH=
FRONTEND_ORIGIN=https://your-frontend.example
AGENT_CYCLE_SECONDS=300
LOG_LEVEL=INFO
