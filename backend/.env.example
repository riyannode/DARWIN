# PostgreSQL connection used by deployed API and worker.
DATABASE_URL=
# OpenAI key used only by backend agent runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional OpenAI-compatible gateway base URL; leave unset for direct OpenAI.
# OPENAI_BASE_URL=
# Official Binance Agent OS MCP endpoint.
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
# Transport used to reach Binance Agent OS. Codex is the supported default.
BINANCE_AGENT_OS_TRANSPORT=codex
# Codex App Server command and exact schema version.
CODEX_APP_SERVER_COMMAND=codex app-server --stdio
CODEX_APP_SERVER_VERSION=0.153.0
# Keep false until manual live confirmation verification is complete.
CODEX_WRITE_CONFIRMATION_VERIFIED=false
# Backend-only Binance Spot API credentials for AUTO_BOUNDED.
# Use a dedicated Spot-trading-only key, disable withdrawals, and restrict IPs.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_SPOT_API_BASE_URL=https://api.binance.com
BINANCE_ACCOUNT_LOCK_KEY=darwinspot-binance-account
BINANCE_RECV_WINDOW_MS=5000
# Fernet key generated outside the repository.
TOKEN_ENCRYPTION_KEY=
# Argon2id hash generated locally without storing the plaintext here.
OWNER_PASSWORD_HASH=
FRONTEND_ORIGIN=https://your-frontend.example
AGENT_CYCLE_SECONDS=300
SIGNAL_COOLDOWN_SECONDS=300
APPROVAL_TTL_SECONDS=90
# Optional backend-only Telegram Bot API configuration.
# Configure all four values together; no Telegram secret belongs in frontend/.env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OPERATOR_CHAT_ID=
# TELEGRAM_OPERATOR_USER_ID=
# TELEGRAM_WEBHOOK_SECRET=
LOG_LEVEL=INFO
