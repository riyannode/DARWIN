# DARWIN LIVE configuration example.
# Keep this file secret-free. Copy it to backend/.env and set real values there.

# -----------------------------------------------------------------------------
# Runtime / database
# -----------------------------------------------------------------------------
# false keeps the backend fail-closed unless explicitly enabled for funded live trading.
DEMO_MODE=false
# Additional final financial-mutation gate. Keep false for judge/demo/showcase runtimes.
FINANCIAL_WRITES_ENABLED=false
# Public GET /api/showcase and frontend /showcase; keep false unless publishing a showcase.
PUBLIC_SHOWCASE_ENABLED=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGIN=https://your-frontend.example
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Model provider
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Current default: gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini
# Optional OpenAI-compatible gateway; leave unset for direct OpenAI.
# OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Owner authentication
# -----------------------------------------------------------------------------
# Generate an Argon2id hash; never put a plaintext password here.
OWNER_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# AUTO_BOUNDED — backend Binance Spot API
# -----------------------------------------------------------------------------
# Use a dedicated backend-only Spot-trading key.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
BINANCE_SPOT_API_BASE_URL=https://api.binance.com
BINANCE_RECV_WINDOW_MS=5000
BINANCE_ACCOUNT_LOCK_KEY=darwinspot-binance-account

# -----------------------------------------------------------------------------
# HUMAN_APPROVAL — Codex App Server + Binance Agent OS MCP
# -----------------------------------------------------------------------------
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_TRANSPORT=codex
CODEX_APP_SERVER_COMMAND="codex app-server --stdio"
CODEX_APP_SERVER_VERSION=0.153.0
# Keep false until a real operator verifies the live write elicitation contract.
CODEX_WRITE_CONFIRMATION_VERIFIED=false
# Required to protect persisted connection/OAuth material.
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Optional Telegram notifications and approval delivery
# Configure all four values together or leave all four unset.
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OPERATOR_CHAT_ID=
# TELEGRAM_OPERATOR_USER_ID=
# TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Scheduling / approval / logging
# -----------------------------------------------------------------------------
AGENT_CYCLE_SECONDS=300
SIGNAL_COOLDOWN_SECONDS=300
APPROVAL_TTL_SECONDS=90
